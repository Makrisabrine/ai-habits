# Copier ce fichier : cp .env.local.example .env.local
# Puis remplacer les valeurs. NE PAS committer .env.local (il est ignoré).

# Base de données MongoDB (local ou MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=habits

# Supabase Auth — Project Settings > API Keys (publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx
# Alias facultatif, même valeur que ci-dessus :
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# IA — une seule clé suffit (priorité OpenRouter > Groq > Gemini)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
